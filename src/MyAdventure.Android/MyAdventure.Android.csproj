<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!--
      SupportedOSPlatformVersion = 23 (Android 6.0 Marshmallow, 2015).

      Bumped from 21 because androidx.lifecycle.runtime — a transitive
      dependency pulled in by Avalonia 12's Android backend — now requires
      minSdk 23. The Android Gradle plugin refuses to merge an
      AndroidManifest with minSdkVersion 21 against an aar declaring 23:

          uses-sdk:minSdkVersion 21 cannot be smaller than version 23
          declared in library .../androidx.lifecycle.lifecycle-runtime-android.aar

      Bumping to 23 is the correct unified fix (no overrideLibrary hack,
      no per-platform manifest divergence). Android 6.0+ covers ~99% of
      active devices and is what every modern Android library now
      requires as a baseline.
    -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>com.myadventure.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyAdventure.Core\MyAdventure.Core.csproj" />
    <ProjectReference Include="..\MyAdventure.Infrastructure\MyAdventure.Infrastructure.csproj" />
    <ProjectReference Include="..\MyAdventure.Shared\MyAdventure.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>
</Project>
