<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\MyAdventure.Core\MyAdventure.Core.csproj" />
    <ProjectReference Include="..\MyAdventure.Infrastructure\MyAdventure.Infrastructure.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Resources\i18n\*.json" />
  </ItemGroup>

  <!-- Grant the UI test project access to internal members so it can
       reach the AppLifecycleManager.ResetForTesting() seam. Production
       callers cannot use ResetForTesting (it's internal); the tests
       need it to keep the manager's static state isolated between cases. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MyAdventure.UI.Tests" />
  </ItemGroup>
</Project>
